# Adresse de l'API FlowManage vue depuis le téléphone.
# Sur un vrai téléphone : IP de l'ordinateur sur le même Wi-Fi (ipconfig / ifconfig)
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1

# Clé Google Maps SDK for Android / iOS (seulement pour les builds, pas pour Expo Go)
GOOGLE_MAPS_API_KEY=

# Identifiant du projet Expo (commande : npx eas init) — nécessaire aux notifications push
EAS_PROJECT_ID=
