# Copier ce fichier en .env puis remplir les valeurs

# --- Supabase (Project Settings → Database → Connection string) ---
# Application : "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations Prisma : "Direct connection" (port 5432)
DIRECT_URL="postgresql://postgres:<mot-de-passe>@db.<ref-projet>.supabase.co:5432/postgres"

# Stockage des photos (Project Settings → API). Laisser vide en local → dossier ./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos

# --- Sécurité ---
# Générer une valeur longue : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a-changer
# Clé partagée avec les services ia/ et cartographie/ (en-tête x-api-key)
INTERNAL_API_KEY=a-changer

# --- Services internes (laisser vide si non lancés : l'API fonctionne sans) ---
IA_URL=http://localhost:8000
CARTO_URL=http://localhost:4000

PORT=3000
# Adresse publique de l'API (utilisée pour les URL des photos en local)
PUBLIC_URL=http://localhost:3000
