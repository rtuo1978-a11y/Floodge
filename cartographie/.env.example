PORT=4000
# API FlowManage (branche backend)
BACKEND_URL=http://localhost:3000/api/v1
# Même valeur que INTERNAL_API_KEY dans backend/.env
INTERNAL_API_KEY=a-changer
# Google Cloud → APIs : activer "Routes API" et "Geocoding API"
GOOGLE_MAPS_API_KEY=
# Recalcul automatique du risque toutes les N minutes (0 = désactivé)
RECALCUL_AUTO_MIN=30
FICHIER_ZONES=data/zones-abidjan-demo.geojson
